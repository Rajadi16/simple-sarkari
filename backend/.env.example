# ─── Application ───
APP_ENV=development
APP_DEBUG=true

# ─── MongoDB ───
MONGO_URL=mongodb://localhost:27017
DB_NAME=janvaani

# ─── AWS ───
AWS_ENABLED=true
AWS_REGION=ap-south-1
S3_BUCKET=replace-with-your-bucket-name
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
POLLY_REGION=ap-south-1
SES_SENDER_EMAIL=alerts@janvaani.in

# ─── Auth ───
REVIEWER_TOKEN=replace-with-shared-demo-token
JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ─── Crawler ───
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; JanVaani/1.0; +https://janvaani.in/about)
CRAWLER_DEFAULT_DELAY_SECONDS=5
CRAWLER_MAX_PAGE_SIZE_MB=10
CRAWLER_MAX_PDF_SIZE_MB=50
CRAWLER_REQUEST_TIMEOUT_SECONDS=30
