# ─── Application ───
APP_ENV=development
APP_DEBUG=true

# ─── MongoDB ───
MONGO_URL=mongodb://localhost:27017
DB_NAME=janvaani

# ─── AWS ───
AWS_ENABLED=true
AWS_REGION=ap-south-1
S3_BUCKET=replace-with-your-bucket-name
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
POLLY_REGION=ap-south-1

# ─── Auth ───
REVIEWER_TOKEN=change-me-to-a-strong-secret
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ─── Crawler ───
CRAWLER_USER_AGENT=JanVaani/1.0 (+https://janvaani.in/about; government-circular-index)
CRAWLER_DEFAULT_DELAY_SECONDS=5
CRAWLER_MAX_PAGE_SIZE_MB=10
CRAWLER_MAX_PDF_SIZE_MB=50
CRAWLER_REQUEST_TIMEOUT_SECONDS=30
